# Copy to .env and fill in real values. Never commit .env.

# Signs session cookies. At least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Initial administrator — used only when no administrator exists yet.
# Changing these later does NOT modify the existing administrator.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password

# SQLite database. Relative paths are resolved from the project root.
DATABASE_URL=sqlite:///./ledger.db

# Private claim evidence storage; never served through /static.
# CLAIM_UPLOAD_DIR=./private_uploads

# 1 = allow balances to go below $0.00. Default 0 (rejected).
ALLOW_NEGATIVE=0

# Optional
SITE_NAME=RefundClaimers  # name shown in the header, footer and page titles
# COOKIE_SECURE=0        # set to 1 when served over HTTPS
# SESSION_MAX_AGE=1209600  # seconds (14 days)
# LOGIN_RATE_LIMIT=10    # failed logins per IP per window
# LOGIN_RATE_WINDOW=300  # seconds
# SEED_DEMO=0            # 1 = create fictional zero-balance demo accounts on startup

# Business email shown on the site; team notifications are sent here.
SUPPORT_EMAIL=support@refundclaimers.com

# Outgoing email. Leave SMTP_PASSWORD blank to turn sending off: forms still work,
# and each skipped email is logged. Test with: python -m backend.send_test_email you@example.com
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true  # true = implicit SSL/TLS, false = STARTTLS
SMTP_USER=support@refundclaimers.com
SMTP_PASSWORD=
MAIL_FROM="RefundClaimers <support@refundclaimers.com>"
